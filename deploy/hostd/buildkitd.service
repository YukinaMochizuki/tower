[Unit]
Description=BuildKit, which builds tower's images on this host
Documentation=https://github.com/moby/buildkit
After=network-online.target
Wants=network-online.target

[Service]
# Its socket is root's alone: hostd, as root, is its only client.
ExecStart=/usr/local/bin/buildkitd --config /etc/buildkit/buildkitd.toml --addr unix:///run/buildkit/buildkitd.sock
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
