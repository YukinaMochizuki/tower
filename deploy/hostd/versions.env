# shellcheck shell=bash disable=SC2034
# Versions pinned for every hostd host and the testbed. Bump a version and
# its checksum together. A sha256 marked "as first fetched" is the file's
# when it was pinned: its project publishes none.

# Cloud Hypervisor and the EDK2 firmware its VMs boot through, as hangar
# pins them (hangar: deploy/host/versions.env).
TOWER_CH_VERSION=v53.0
TOWER_CH_URL="https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/${TOWER_CH_VERSION}/cloud-hypervisor-static"
TOWER_CH_SHA256=448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc
TOWER_FW_VERSION=ch-97eeb7b09
TOWER_FW_URL="https://github.com/cloud-hypervisor/edk2/releases/download/${TOWER_FW_VERSION}/CLOUDHV.fd"
TOWER_FW_SHA256=dc2fc8f0e43b96712d9fccc52a3a590769606412b3e1bc911d217addd3bef624

# BuildKit, which builds images and pushes them to the registry
# (docs/decisions/images.md). As first fetched.
TOWER_BUILDKIT_VERSION=v0.34.1
TOWER_BUILDKIT_URL="https://github.com/moby/buildkit/releases/download/${TOWER_BUILDKIT_VERSION}/buildkit-${TOWER_BUILDKIT_VERSION}.linux-amd64.tar.gz"
TOWER_BUILDKIT_SHA256=a59539daf547fe0958efe2d07e41c0a6944e1112a66d7e519ec1cf5b673ef15b

# The CNI plugins BuildKit puts each build step on its own network with
# (docs/decisions/images.md), from the release's .sha256.
TOWER_CNI_VERSION=v1.9.1
TOWER_CNI_URL="https://github.com/containernetworking/plugins/releases/download/${TOWER_CNI_VERSION}/cni-plugins-linux-amd64-${TOWER_CNI_VERSION}.tgz"
TOWER_CNI_SHA256=b98f74a0f8522f0a83867178729c1aa70f2158f90c45a2ca8fa791db1c76b303

# zot, the registry beside tower, from its release's checksums.sha256.txt.
TOWER_ZOT_VERSION=v2.1.22
TOWER_ZOT_URL="https://github.com/project-zot/zot/releases/download/${TOWER_ZOT_VERSION}/zot-linux-amd64"
TOWER_ZOT_SHA256=33b9b5bfe05d6788c076de951a01920477dbd6395c330146e23cc2340073e52e

# The base images VMs boot (VMSpec.BaseImage), each a cloud image made raw
# by base-image.sh. Ubuntu's sha256 is from the release's SHA256SUMS;
# Alpine's, the testbed's small one, as first fetched.
TOWER_UBUNTU_2404_URL="https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img"
TOWER_UBUNTU_2404_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
TOWER_ALPINE_URL="https://dl-cdn.alpinelinux.org/alpine/v3.22/releases/cloud/nocloud_alpine-3.22.4-x86_64-uefi-cloudinit-r0.qcow2"
TOWER_ALPINE_SHA256=5a3bb21c06a22c31cfb8e040c61311a3cf942d9ad1da1ee9ea9d7c2e1dd2e6aa

# Go, for the testbed alone, which builds there.
TOWER_GO_VERSION=1.27.2
TOWER_GO_URL="https://go.dev/dl/go${TOWER_GO_VERSION}.linux-amd64.tar.gz"
TOWER_GO_SHA256=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5

TOWER_HOSTD_PACKAGES="zfsutils-linux docker.io git curl ca-certificates qemu-utils e2fsprogs iproute2 nftables iptables"
