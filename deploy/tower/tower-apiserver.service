[Unit]
Description=tower's apiserver
Documentation=file:///usr/local/share/doc/tower/runbook/deploy.md
# It listens on the host's tailnet address alone (docs/decisions/
# authentication.md), which is there once tailscaled is up.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=tower
Group=tower
# TOWER_LISTEN: the host's tailnet address and port, such as
# 100.64.0.2:8080, never every interface (docs/runbook/deploy.md).
# TOWER_DEFAULT_BOX_IMAGE: what a box of a repository without a
# devcontainer is made of when workstream names no fallback; empty fails
# such a box (docs/decisions/devcontainers.md).
EnvironmentFile=/etc/tower/apiserver.env
# Its database, key-encryption key and ticket key are in /var/lib/tower,
# the user's alone; the admin socket, root's way in, in /run/tower.
StateDirectory=tower
StateDirectoryMode=0700
RuntimeDirectory=tower
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/tower-apiserver \
	--listen ${TOWER_LISTEN} \
	--db /var/lib/tower/tower.db \
	--admin-socket /run/tower/admin.sock \
	--secrets-kek /var/lib/tower/secrets-kek \
	--ticket-key /var/lib/tower/ticket-key \
	--default-box-image ${TOWER_DEFAULT_BOX_IMAGE}
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
